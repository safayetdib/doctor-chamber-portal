{
  "name": "@practice/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "tsx --env-file-if-exists=.env src/scripts/check-database.ts"
  },
  "dependencies": {
    "@practice/contracts": "workspace:*",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.8.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
