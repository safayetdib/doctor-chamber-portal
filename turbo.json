{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_ORIGIN"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["NODE_ENV", "HOST", "PORT", "MONGODB_URI", "MONGODB_DB", "LOG_LEVEL", "API_INTERNAL_ORIGIN", "PUBLIC_APP_ORIGIN", "IDENTITY_OTP_SECRET", "JWT_SESSION_SECRET"]
    },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [] }
  }
}
